        PA[Passenger App]
        DA[Driver App]
    end
    
    subgraph "API Layer"
        APIM[API Management Gateway]
    end
    
    subgraph "Business Logic"
        MS[Microservices]
    end
    
    subgraph "Event Processing"
        SB[Service Bus]
        AF[Azure Functions]
    end
    
    subgraph "Data Storage"
        DB[(Cosmos DB)]
